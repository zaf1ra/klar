{
  "version": 3,
  "updated": "2026-11-04",
  "adDomains": [
    "doubleclick.net",
    "googlesyndication.com",
    "googleadservices.com",
    "google-analytics.com",
    "googletagmanager.com",
    "adservice.google.com",
    "imasdk.googleapis.com",
    "pagead2.googlesyndication.com",
    "an.facebook.com",
    "connect.facebook.net"
  ],
  "sites": [
    {
      "id": "instagram",
      "name": "Instagram",
      "icon": "camera",
      "home": "https://www.instagram.com/?variant=following",
      "allowedHosts": [
        "instagram.com",
        "facebook.com",
        "fbcdn.net",
        "cdninstagram.com"
      ],
      "blockedPaths": [
        "^/reels?/",
        "^/explore(/(?!search)|/?$)"
      ],
      "redirects": [
        {
          "path": "^/$",
          "unlessQuery": "variant=following",
          "to": "/?variant=following"
        }
      ],
      "hideSelectors": [
        "a[href=\"/reels/\"]",
        "a[href=\"/explore/\"]",
        "a[href$=\"/reels/\"][role=\"tab\"]",
        "a[href*=\"/reels/audio/\"]"
      ],
      "containerRules": [
        {
          "id": "sponsored",
          "label": "Werbung",
          "container": "article",
          "text": [
            "Gesponsert",
            "Sponsored"
          ]
        },
        {
          "id": "suggested",
          "label": "Vorschläge",
          "container": "article",
          "text": [
            "Vorgeschlagen für dich",
            "Suggested for you",
            "Vorgeschlagene Beiträge",
            "Suggested posts"
          ]
        },
        {
          "id": "feed-reels",
          "label": "Reels im Feed",
          "container": "article",
          "has": "a[href*=\"/reel/\"]"
        }
      ],
      "probes": [
        {
          "id": "reels-tab",
          "label": "Reels-Tab",
          "selector": "a[href=\"/reels/\"]",
          "path": ".*",
          "requiresLogin": true,
          "expectHidden": true
        },
        {
          "id": "feed-posts",
          "label": "Beiträge im Feed",
          "selector": "article",
          "path": "^/$",
          "requiresLogin": true,
          "expectHidden": false
        }
      ],
      "loginCookie": "sessionid",
      "ciCheck": {
        "url": "https://www.instagram.com/?variant=following",
        "cookieEnv": "IG_SESSIONID",
        "cookieName": "sessionid",
        "cookieDomain": ".instagram.com",
        "probes": [
          "reels-tab",
          "feed-posts"
        ]
      },
      "siteBarContains": [
        "a[href*=\"/direct/\"]",
        "a[href=\"/explore/\"]",
        "a[href=\"/reels/\"]"
      ],
      "tabs": [
        {
          "id": "home",
          "label": "Start",
          "icon": "house",
          "url": "/?variant=following",
          "match": "^/$"
        },
        {
          "id": "search",
          "label": "Suche",
          "icon": "magnifyingglass",
          "url": "/explore/search/",
          "match": "^/explore/search"
        },
        {
          "id": "create",
          "label": "Erstellen",
          "icon": "plus.app",
          "menu": [
            {
              "label": "Beitrag erstellen",
              "icon": "square.and.pencil",
              "click": [
                "svg[aria-label=\"Neuer Beitrag\"]",
                "svg[aria-label=\"New post\"]",
                "svg[aria-label=\"Erstellen\"]",
                "svg[aria-label=\"Create\"]",
                "a[href=\"/create/select/\"]",
                "a[href=\"/create/style/\"]"
              ]
            },
            {
              "label": "Story in der Instagram-App",
              "icon": "camera",
              "appURL": "instagram://story-camera",
              "appMissing": "Instagram ist nicht installiert. Für Storys mit Musik und Stickern brauchst du die Instagram-App."
            }
          ]
        },
        {
          "id": "direct",
          "label": "Nachrichten",
          "icon": "paperplane",
          "url": "/direct/inbox/",
          "match": "^/direct"
        },
        {
          "id": "profile",
          "label": "Profil",
          "icon": "person.crop.circle",
          "click": [
            "[data-klar-sitebar] a[href^=\"/\"]:has(img)"
          ]
        }
      ],
      "iconURL": "https://static.cdninstagram.com/rsrc.php/yw/r/icwX0xAk0pz.webp"
    },
    {
      "id": "youtube",
      "name": "YouTube",
      "icon": "play.rectangle",
      "home": "https://m.youtube.com/feed/subscriptions",
      "allowedHosts": [
        "youtube.com",
        "youtu.be",
        "google.com",
        "googlevideo.com",
        "ytimg.com",
        "gstatic.com"
      ],
      "blockedPaths": [
        "^/shorts",
        "^/feed/trending",
        "^/feed/explore"
      ],
      "redirects": [
        {
          "path": "^/$",
          "to": "/feed/subscriptions"
        }
      ],
      "hideSelectors": [
        "ytm-reel-shelf-renderer",
        "ytm-shorts-lockup-view-model",
        "ytm-shorts-lockup-view-model-v2",
        "ytm-pivot-bar-item-renderer:has(.pivot-shorts)",
        "ytm-pivot-bar-item-renderer:has(a[href^=\"/shorts\"])",
        "ytm-rich-section-renderer:has(a[href^=\"/shorts\"])",
        "ytm-video-with-context-renderer:has(a[href^=\"/shorts\"])",
        "ytm-promoted-sparkles-web-renderer",
        "ytm-promoted-video-renderer",
        "ytm-companion-ad-renderer",
        "ad-slot-renderer",
        "ytm-ad-slot-renderer",
        ".ytp-ad-overlay-container",
        "ytm-item-section-renderer[section-identifier=\"related-items\"]",
        "ytm-autonav-toggle-button-container",
        ".ytm-autonav-bar",
        "ytm-pivot-bar-renderer"
      ],
      "containerRules": [],
      "skipVideoAds": {
        "adShowing": ".ad-showing video",
        "skipButtons": ".ytp-ad-skip-button, .ytp-ad-skip-button-modern, .ytp-skip-ad-button"
      },
      "probes": [
        {
          "id": "shorts-tab",
          "label": "Shorts-Tab",
          "selector": "ytm-pivot-bar-item-renderer .pivot-shorts, ytm-pivot-bar-item-renderer a[href^=\"/shorts\"]",
          "path": ".*",
          "requiresLogin": false,
          "expectHidden": true
        },
        {
          "id": "shorts-shelf",
          "label": "Shorts in der Suche",
          "selector": "ytm-reel-shelf-renderer, ytm-shorts-lockup-view-model, ytm-shorts-lockup-view-model-v2, a[href^=\"/shorts\"]",
          "path": "^/results",
          "requiresLogin": false,
          "expectHidden": true
        }
      ],
      "loginCookie": "LOGIN_INFO",
      "ciCheck": {
        "url": "https://m.youtube.com/results?search_query=musik",
        "probes": [
          "shorts-tab",
          "shorts-shelf"
        ]
      },
      "tabs": [
        {
          "id": "home",
          "label": "Startseite",
          "icon": "house",
          "url": "/feed/subscriptions",
          "match": "^/feed/subscriptions"
        },
        {
          "id": "search",
          "label": "Suche",
          "icon": "magnifyingglass",
          "search": "/results?search_query={q}",
          "match": "^/results"
        },
        {
          "id": "channels",
          "label": "Abos",
          "icon": "play.square.stack",
          "url": "/feed/channels",
          "match": "^/feed/channels"
        },
        {
          "id": "later",
          "label": "Später ansehen",
          "icon": "play.rectangle",
          "url": "/playlist?list=WL",
          "match": "^/playlist"
        },
        {
          "id": "you",
          "label": "Mein YouTube",
          "icon": "person.crop.circle",
          "url": "/feed/you",
          "match": "^/feed/(you|library|history)"
        }
      ],
      "iconURL": "https://m.youtube.com/static/apple-touch-icon-180x180-precomposed.png",
      "iconBackground": "#FFFFFF",
      "iconScale": 0.62
    },
    {
      "id": "snapchat",
      "name": "Snapchat",
      "icon": "bubble.left.and.bubble.right",
      "home": "https://accounts.snapchat.com/v2/login?continue=https%3A%2F%2Fwww.snapchat.com%2Fweb%2F",
      "allowedHosts": [
        "snapchat.com",
        "snap.com",
        "sc-static.net",
        "sc-cdn.net",
        "snapkit.com",
        "google.com",
        "gstatic.com"
      ],
      "blockedPaths": [
        "^/spotlight",
        "^/discover"
      ],
      "redirects": [],
      "hideSelectors": [],
      "containerRules": [],
      "probes": [],
      "loginCookie": "",
      "desktopMode": true,
      "iconURL": "https://www.snapchat.com/apple-touch-icon.png",
      "iconFlood": "#FFFC00"
    },
    {
      "id": "pinterest",
      "name": "Pinterest",
      "icon": "pin",
      "home": "https://www.pinterest.com/",
      "allowedHosts": [
        "pinterest.com",
        "pinterest.de",
        "pinterest.at",
        "pinterest.ch",
        "pinimg.com",
        "google.com",
        "gstatic.com"
      ],
      "blockedPaths": [
        "^/watch"
      ],
      "redirects": [],
      "hideSelectors": [],
      "containerRules": [
        {
          "id": "pin-ads",
          "label": "Werbung",
          "container": "[data-grid-item=\"true\"]",
          "text": [
            "Gesponsert",
            "Promoted",
            "Werbung"
          ]
        },
        {
          "id": "pin-videos",
          "label": "Video-Pins",
          "container": "[data-grid-item=\"true\"]",
          "has": "video"
        }
      ],
      "probes": [],
      "loginCookie": "",
      "iconURL": "https://s.pinimg.com/webapp/logo_transparent_144x144-3da7a67b.png",
      "iconBackground": "#FFFFFF",
      "iconScale": 0.72
    },
    {
      "id": "substack",
      "name": "Substack",
      "icon": "newspaper",
      "home": "https://substack.com/inbox",
      "allowedHosts": [
        "substack.com",
        "substackcdn.com",
        "google.com",
        "gstatic.com",
        "apple.com"
      ],
      "blockedPaths": [],
